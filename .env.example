# Prisma Postgres connection string. This project is already provisioned via
# Prisma Compute — copy the real value from the Prisma Console
# (App -> Environment variables) or a `prisma platform db` command.
# For local dev, a single Accelerate-backed URL (prisma+postgres://...) works
# for both the app and `prisma migrate`/seed.
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# Optional: on Prisma Compute, Prisma auto-injects a second, pooled
# (Accelerate) connection string alongside the direct DATABASE_URL above.
# lib/prisma.ts and prisma/seed.ts prefer this for the app/seed connection
# when present, and fall back to DATABASE_URL otherwise (used locally).
# DATABASE_URL_POOLED="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# OpenAI API key used by the /api/query AI orchestrator (Ask AI page +
# forecasting tool). Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional: override the tool-calling model. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL="gpt-4o-mini"
