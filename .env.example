# Prisma Postgres connection string (Accelerate-backed, prisma+postgres://...).
# This project is already provisioned via the GitHub <-> Prisma Postgres
# integration, so the real value lives in the Vercel project's environment
# variables — copy it from there, or run `vercel env pull .env` if the
# Vercel CLI is linked to this project.
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."

# OpenAI API key used by the /api/query AI orchestrator (Ask AI page +
# forecasting tool). Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional: override the tool-calling model. Defaults to gpt-4o-mini if unset.
OPENAI_MODEL="gpt-4o-mini"
